---
import '@equity/shared/theme.css';
// Astro Component Script
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Welcome to Equity Valuation Engine</title>
  </head>
  <body class="bg-background text-on-background min-h-screen flex flex-col items-center justify-center p-8 font-body-base">
    <main class="max-w-3xl text-center space-y-8">
      <h1 class="text-display-md text-primary font-header-sm">Equity Valuation Engine</h1>
      <p class="text-on-surface-variant text-lg">
        The most advanced AI-powered platform for fundamental value investing.
      </p>
      
      <div class="pt-8">
        <a 
          href="http://localhost:5173" 
          class="inline-flex items-center justify-center bg-primary text-on-primary hover:bg-on-primary-container px-6 py-3 rounded-full font-label-caps transition-colors"
        >
          OPEN APP
        </a>
      </div>
    </main>
  </body>
</html>
